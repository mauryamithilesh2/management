# Copy this file to .env and fill in real values for your environment.
# Never commit the actual .env file.

# Django secret key - generate a new one for production
SECRET_KEY=change-this-to-a-long-random-secret-key

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=127.0.0.1,localhost

# Database configuration
# Leave DATABASE_URL empty to use local SQLite (default for development).
# For PostgreSQL in the future, set e.g.:
# DATABASE_URL=postgres://user:password@localhost:5432/etms
DATABASE_URL=
